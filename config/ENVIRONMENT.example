# Non-live validation infrastructure placeholders
NODE_ENV=development
PORT=3000

# Supabase/PostgreSQL (server-side only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment provider (server-side only; leave blank for mock mode)
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Telegram (server-side only; leave blank for mock mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_GROUP_ID=

# Internal admin protection
# REQUIRED for admin endpoints. The server FAILS CLOSED: if ADMIN_TOKEN is unset,
# admin endpoints are disabled with an explicit error (there is no default token).
# Use a long random value in production. Never commit the real value.
# Example value below is for local development only.
ADMIN_TOKEN=dev-admin-token
